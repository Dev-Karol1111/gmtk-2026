id = "a-joke"
text = "Sadly I'm not, you will die in 24 hours"
person = "first-person"
options = Dictionary[String, String]({
"Ask something else": "doctor-1"
})
metadata/_custom_type_script = "uid://d366eisakga4q"

[sub_resource type="Resource" id="Resource_4ykdn"]
