[sub_resource type="Resource" id="Resource_ijhw1"]
script = ExtResource("1_ijhw1")
id = "doctor-1"
text = "Welcome back! There's
something I have to tell you.
We did a bunch of test on you
and it turns out you are
terminaly ill."
person = "first-person"
options = Dictionary[String, String]({
"Are you kidding me?!": "q-joke",
"How long do I have left?": "q-time-left",
"Ow uh ok then...": "continue"
})
metadata/_custom_type_script = "uid://d366eisakga4q"

[sub_resource type="Resource" id="Resource_d30oi"]
script = ExtResource("1_ijhw1")
id = "a-time-left"
text = "You only have 24 hours left. I'm sorry."
person = "first-person"
options = Dictionary[String, String]({
"Ask something else": "doctor-1"
})
metadata/_custom_type_script = "uid://d366eisakga4q"

[sub_resource type="Resource" id="Resource_4cd6u"]
